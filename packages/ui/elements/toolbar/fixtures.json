			"filters": [{ "id": "state", "type": "chips", "label": "Lease state", "value": "all", "options": [{ "value": "all", "label": "All" }, { "value": "active", "label": "Active" }, { "value": "static", "label": "Static" }, { "value": "expired", "label": "Expired" }] }],
			"view": { "label": "Layout", "value": "table", "options": [{ "id": "table", "label": "Table", "icon": "table-list", "iconOnly": true }, { "id": "cards", "label": "Cards", "icon": "grip", "iconOnly": true }] },
			"actions": [{ "id": "export", "label": "Export", "icon": "download" }] } },
		{ "name": "Selection active", "width": "full", "config": {
			"search": true,
			"bulk": [{ "id": "release", "label": "Release", "icon": "eject" }, { "id": "static", "label": "Make static", "icon": "thumbtack" }],
			"actions": [{ "id": "refresh", "label": "Refresh", "icon": "rotate-right", "iconOnly": true }],
			"selection": 3 } },
		{ "name": "Search only", "width": "md", "config": { "search": { "placeholder": "Filter aliases" } } }
