				{ "el": "card", "config": { "title": "igc0", "content": { "el": "status", "config": { "state": "ok", "label": "Up", "variant": "dot" } } } },
				{ "el": "card", "config": { "title": "igc1", "content": { "el": "status", "config": { "state": "ok", "label": "Up", "variant": "dot" } } } },
				{ "el": "card", "config": { "title": "igc2", "content": { "el": "status", "config": { "state": "ok", "label": "Up", "variant": "dot" } } } },
				{ "el": "card", "config": { "title": "igc3", "content": { "el": "status", "config": { "state": "crit", "label": "No carrier", "variant": "dot" } } } },
				{ "el": "card", "config": { "title": "wg0", "content": { "el": "status", "config": { "state": "ok", "label": "Up", "variant": "dot" } } } },
