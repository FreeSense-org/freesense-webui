				{ "el": "card", "config": { "title": "WAN", "icon": "globe", "subtitle": "igc0 · 203.0.113.24", "content": { "el": "status", "config": { "state": "ok", "label": "Online", "detail": "8.4 ms" } } } },
				{ "el": "card", "config": { "title": "WAN2", "icon": "globe", "subtitle": "pppoe0 · 198.51.100.7", "content": { "el": "status", "config": { "state": "warn", "label": "Packet loss", "detail": "4%" } } } },
				{ "el": "card", "config": { "title": "WireGuard", "icon": "lock", "subtitle": "wg0 · 3 peers", "content": { "el": "status", "config": { "state": "ok", "label": "2 connected" } } } },
				{ "el": "card", "config": { "title": "Updates", "icon": "cloud-arrow-down", "subtitle": "Development channel", "content": { "el": "status", "config": { "state": "info", "label": "Update available" } } } }
			] } },
		{ "name": "Mixed spans (8 + 4)", "width": "full", "surface": "page", "config": {
