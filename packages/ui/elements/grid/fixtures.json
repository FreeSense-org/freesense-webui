				] } } },
				{ "el": "card", "span": { "base": 12, "lg": 4 }, "config": { "title": "Gateways", "icon": "route", "content": [
					{ "el": "status", "config": { "state": "ok", "label": "WAN_DHCP", "detail": "8.4 ms" } },
					{ "el": "status", "config": { "state": "warn", "label": "WAN2_PPPOE", "detail": "4% loss" } },
					{ "el": "status", "config": { "state": "ok", "label": "WG_SITE_GW", "detail": "21.8 ms" } }
				] } }
			] } },
		{ "name": "Many items, small gap", "width": "full", "surface": "page", "config": {
