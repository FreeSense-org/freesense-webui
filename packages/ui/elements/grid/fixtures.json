{
	"title": "Grid",
	"description": "Responsive 12-column layout of nested elements, with a span per breakpoint.",
	"status": "draft",
	"fixtures": [
		{ "name": "Overview cards with statuses", "width": "full", "surface": "page", "config": {
			"span": { "base": 12, "sm": 6, "lg": 3 },
