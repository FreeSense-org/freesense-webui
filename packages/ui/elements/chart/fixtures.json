		{ "name": "Live only (no history)", "width": "lg", "config": { "title": "GUEST traffic", "unit": "bps", "range": "10m", "height": 180, "area": true, "live": { "path": "/v1/status/traffic", "query": { "if": "opt1" }, "every": 1 }, "series": [{ "live": "opt1.in_bps", "label": "In" }, { "live": "opt1.out_bps", "label": "Out" }] } },
