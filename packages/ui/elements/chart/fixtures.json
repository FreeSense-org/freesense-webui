		{ "name": "CPU and memory (pct)", "width": "lg", "config": { "title": "CPU and memory", "unit": "pct", "min": 0, "max": 100, "range": "1h", "ranges": ["1h", "24h", "7d"], "history": { "path": "/v1/status/system/history" }, "series": [{ "field": "cpu", "label": "CPU", "color": 1, "fill": true }, { "field": "mem", "label": "Memory", "color": 5 }] } },
