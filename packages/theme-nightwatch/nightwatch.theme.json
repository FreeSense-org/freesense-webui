{
	"$schema": "../../schema/theme-2.0.schema.json",
	"scheme": "2.0",
	"name": "nightwatch",
	"title": "Nightwatch",
	"description": "A network operations console: near-black surfaces, hairline borders, electric cyan, square corners and dense rows; a crisp high-contrast daylight mode.",
	"version": "2.0.0-alpha.0",
	"author": "The FreeSense Project",
	"license": "Apache-2.0",
	"homepage": "https://www.freesense.org",
	"defaultMode": "dark",
	"defaultAccent": "cyan",
	"accents": {
		"cyan": {
			"title": "Cyan",
			"light": { "fill": "#0e7490", "text": "#0e7490", "on": "#ffffff" },
			"dark": { "fill": "#22d3ee", "text": "#67e8f9", "on": "#031418" }
		},
		"green": {
			"title": "Phosphor",
			"light": { "fill": "#15703a", "text": "#146c2e", "on": "#ffffff" },
			"dark": { "fill": "#3fb950", "text": "#56d364", "on": "#04140a" }
		},
		"amber": {
			"title": "Amber",
			"light": { "fill": "#8a5300", "text": "#7a4a00", "on": "#ffffff" },
			"dark": { "fill": "#e3b341", "text": "#f2cc60", "on": "#1a1102" }
		},
		"magenta": {
			"title": "Magenta",
			"light": { "fill": "#a21caf", "text": "#86198f", "on": "#ffffff" },
			"dark": { "fill": "#e879f9", "text": "#f0abfc", "on": "#1f0322" }
		}
	},
	"modes": {
		"light": {
			"surface": {
				"page": "#e9edf1",
				"raised": "#ffffff",
				"sunken": "#f2f4f7",
				"overlay": "#0a0d1266",
				"topbar": "#f7f8fa",
				"section": "#ffffff"
			},
			"text": {
				"strong": "#000000",
				"default": "#11161d",
				"muted": "#47525e",
				"topbar": "#11161d"
			},
			"border": {
				"default": "#b9c2cc",
				"strong": "#687583",
				"focus": "#0e7490"
			},
			"status": {
				"ok": "#146c2e",
				"warn": "#8a5300",
				"crit": "#c1121f",
				"info": "#0550ae",
				"neutral": "#47525e"
			},
			"action": {
				"pass": "#146c2e",
				"block": "#c1121f",
				"reject": "#a33f00",
				"match": "#7d2fb8"
			},
			"series": {
				"colors": ["#0e7490", "#8b2fc9", "#1a7f37", "#9a6700", "#c4322b", "#2f5fb3", "#b4246d", "#5b6b00"],
				"other": "#6e7781"
			},
			"chart": {
				"grid": "#dde2e8",
				"text": "#47525e"
			},
			"shadow": {
				"sm": "none",
				"md": "none",
				"lg": "0 8px 24px #0a0d1229"
			}
		},
		"dark": {
			"surface": {
				"page": "#07090c",
				"raised": "#0d1117",
				"sunken": "#0a0d12",
				"overlay": "#000000b3",
				"topbar": "#0a0d12",
				"section": "#0d1117"
			},
			"text": {
				"strong": "#eef3f8",
				"default": "#c3cfdb",
				"muted": "#8593a3",
				"topbar": "#c3cfdb"
			},
			"border": {
				"default": "#1f2833",
				"strong": "#566577",
				"focus": "#22d3ee"
			},
			"status": {
				"ok": "#3fb950",
				"warn": "#d29922",
				"crit": "#f85149",
				"info": "#58a6ff",
				"neutral": "#8593a3"
			},
			"action": {
				"pass": "#3fb950",
				"block": "#f85149",
				"reject": "#f0883e",
				"match": "#c084fc"
			},
			"series": {
				"colors": ["#22d3ee", "#c084fc", "#3fb950", "#d29922", "#f85149", "#58a6ff", "#f472b6", "#a3e635"],
				"other": "#6e7681"
			},
			"chart": {
				"grid": "#161d26",
				"text": "#7d8b9b"
			},
			"shadow": {
				"sm": "none",
				"md": "none",
				"lg": "0 12px 32px #000000cc"
			}
		}
	},
	"shape": {
		"radiusSm": "2px",
		"radiusMd": "3px",
		"radiusLg": "4px",
		"borderWidth": "1px",
		"focusWidth": "2px"
	},
	"densities": {
		"comfortable": { "base": "14px", "control": "34px", "row": "36px", "gap": "12px", "pad": "14px" },
		"compact": { "base": "13px", "control": "28px", "row": "28px", "gap": "8px", "pad": "10px" }
	},
	"fonts": {
		"ui": { "family": "Inter" },
		"mono": { "family": "JetBrains Mono" }
	},
	"motion": {
		"fast": "100ms",
		"base": "160ms",
		"slow": "240ms"
	},
	"skin": {
		"topbar": "surface",
		"sectionMenu": "sunken",
		"cards": "outlined",
		"tables": "zebra",
		"buttons": "square"
	}
}
