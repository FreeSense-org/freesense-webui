{
	"scheme": "2.0",
	"name": "nightwatch",
	"title": "Nightwatch",
	"version": "2.0.0-alpha.0",
	"description": "A network operations console: near-black surfaces, hairline borders, electric cyan, square corners and dense rows; a crisp high-contrast daylight mode.",
	"author": "The FreeSense Project",
	"license": "Apache-2.0",
	"defaultMode": "dark",
	"defaultAccent": "cyan",
	"accents": {
		"cyan": {
			"title": "Cyan",
			"light": "#0e7490",
			"dark": "#22d3ee"
		},
		"green": {
			"title": "Phosphor",
			"light": "#15703a",
			"dark": "#3fb950"
		},
		"amber": {
			"title": "Amber",
			"light": "#8a5300",
			"dark": "#e3b341"
		},
		"magenta": {
			"title": "Magenta",
			"light": "#a21caf",
			"dark": "#e879f9"
		}
	},
	"skin": {
		"topbar": "surface",
